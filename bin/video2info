#!/usr/bin/env bash
# video2info — extract the slides and transcript of a video (YouTube, playlists, local files) into
# Markdown notes (each slide with what was said while it was shown), searchable PDF and/or plain text.
# Pipeline: yt-dlp (+jq) or a local file → ffmpeg (frames, SSIM slide changes) → tesseract (OCR)
#           → awk dedup → jq (md, txt) / pdfunite (pdf).  Local transcripts: yap (macOS) or whisper.cpp.
set -euo pipefail
VERSION=0.3.0

usage() {
  cat <<EOF
Usage: video2info URL [options]              a YouTube video or playlist (or any yt-dlp site)
       video2info VIDEO_FILE... [options]    local videos, transcribed on-device

  Local transcripts use yap on macOS 26+, else whisper.cpp (whisper-cli; its model is
  downloaded to ~/.cache/video2info on first use, or set VIDEO2INFO_WHISPER_MODEL).

  -f, --format LIST        md, pdf, txt or a comma list (default: md)
                             md:  notes, each slide (image + OCR text) with its transcript lines
                             pdf: searchable slide PDF        txt: timestamped transcript
  -o NAME                  base name of the combined files for several videos (default: Combined)
  -d DIR                   output folder (default: ./outputs/<timestamp>)
  --lang CODE              transcript language (default: the video's own language;
                           local files: en-US, e.g. --lang es-ES)
  --ocr-lang LANGS         tesseract languages, e.g. eng+spa (default: eng)
  -j N                     parallel OCR jobs (default: CPU cores)
  --ssim T                 slide-change threshold 0-1 (default: 0.9; higher = more slides)
  --crop SIDES             cut edges off every frame, e.g. right=25%,bottom=10% (a fixed webcam or player bar)
  --transcript-only        no slides
  --no-transcript          no transcript
  --check                  show which required tools are installed
  --version                print the version
EOF
}

die()  { printf 'video2info: %s\n' "$*" >&2; exit 1; }
log()  { printf '\033[1m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }

# ---------------------------------------------------------------- embedded jq / awk programs
IFS= read -r -d '' JQ_ENTRIES <<'JQ' || true
# yt-dlp --flat-playlist -J  ->  "order<TAB>url<TAB>safe_title" per video, in playlist order.
# Order comes from a "#N" in the title when present, else the playlist position.
def safe: gsub("[^\\p{L}\\p{N} ]"; "") | sub(" +$"; "") | gsub(" "; "_");

(if has("entries") then [.entries | to_entries[] | {i: .key, e: .value}]
 else [{i: 0, e: (. + {url: (.webpage_url // .url)})}] end)
| map(.e as $e
      | ($e.title // "Video_\(.i + 1)") as $t
      | {order: (($t | capture("#(?<n>[0-9]+)").n | tonumber) // (.i + 1)),
         url: ($e.url // "https://www.youtube.com/watch?v=\($e.id)"),
         title: ($t | safe)})
| sort_by(.order)[]
| [.order, .url, .title] | @tsv
JQ

IFS= read -r -d '' JQ_FILES <<'JQ' || true
# local video paths (one per line)  ->  "order<TAB>path<TAB>safe_title", in the given order.
def safe: gsub("[^\\p{L}\\p{N} ]"; "") | sub(" +$"; "") | gsub(" "; "_");
split("\n") | map(select(. != "")) | to_entries[]
| [.key + 1, .value, (.value | sub(".*/"; "") | sub("\\.[^.]*$"; "") | safe)] | @tsv
JQ

IFS= read -r -d '' JQ_CAPTIONS <<'JQ' || true
# info.json  ->  "track_key<TAB>source<TAB>json3_url" for the best caption track.
# --arg lang CODE: requested language ("" / default / auto = the video's own language).
def find($d; $t):
  ($t | ascii_downcase) as $tl | ($tl | split("-")[0]) as $b | ($d | keys_unsorted) as $ks
  | first($ks[] | select(ascii_downcase | . == "\($tl)-orig" or . == $tl))
    // first($ks[] | select(ascii_downcase | . == "\($b)-orig" or . == $b))
    // first($ks[] | select(ascii_downcase | startswith("\($b)-")));

(.subtitles // {}) as $s | (.automatic_captions // {}) as $a | (.language // "") as $dl
| ($lang | ascii_downcase) as $l
| (if $l != "" and $l != "default" and $l != "auto" then
     (find($s; $lang) | [., "manual"])
     // (find($a; $lang) | [., "auto"])
     // error("no transcript for requested language '\($lang)'")
   else
     (if $dl != "" then find($s; $dl) | [., "manual"] else empty end)
     // first($a | keys_unsorted[] | select(ascii_downcase | endswith("-orig")) | [., "auto-orig"])
     // (if $dl != "" then find($a; $dl) | [., "auto"] else empty end)
     // first($s | keys_unsorted[] | [., "manual-fallback"])
     // first(("es", "en") as $f | find($a; $f) | [., "auto-fallback"])
     // first($a | keys_unsorted[] | [., "auto-fallback"])
     // error("no subtitles or automatic captions available")
   end) as [$key, $src]
| (if ($src | startswith("manual")) then $s else $a end)[$key] as $fmts
| [$key, $src, (first($fmts[]? | select(.ext == "json3" and .url) | .url) // "")] | @tsv
JQ

IFS= read -r -d '' JQ_EVENTS <<'JQ' || true
# json3 captions  ->  tr.json {lang_line, events: [{t: ms, text}]}: whitespace cleaned, repeats dropped.
# --arg lang_line
{lang_line: $lang_line,
 events: ([.events[]? | select(.segs)
   | {t: (.tStartMs // 0), text: ([.segs[].utf8 // ""] | join("") | gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; ""))}
   | select(.text != "")]
   | reduce .[] as $e ([]; if length > 0 and .[-1].text == $e.text then . else . + [$e] end))}
JQ

IFS= read -r -d '' JQ_TS <<'JQ' || true
def pad: tostring | if length < 2 then "0" + . else . end;
def ts: (. / 1000 | floor) as $s | ($s / 3600 | floor) as $h | (($s % 3600) / 60 | floor) as $m
  | if $h > 0 then "\($h | pad):\($m | pad):\($s % 60 | pad)" else "\($m | pad):\($s % 60 | pad)" end;
JQ

IFS= read -r -d '' JQ_TXT <<'JQ' || true
# tr.json  ->  transcript text (header, full text, timestamped lines).   --arg title, url
"Title: \($title)\nURL: \($url)\nLanguage: \(.lang_line)\n\("=" * 80)\n\n### FULL TEXT ###\n\n"
+ (.events | map(.text) | join(" ")) + "\n\n### TIMESTAMPED TRANSCRIPT ###\n\n"
+ (.events | map("[\(.t | ts)] \(.text)") | join("\n"))
JQ

IFS= read -r -d '' JQ_MD <<'JQ' || true
# Markdown notes.  --arg title, url   --slurpfile tr tr.json   --slurpfile sl slides.json ([{t, img, text}])
# Each slide: heading with its time, image, OCR text as a quote, then the transcript lines said while it was shown.
def lines: map("- [\(.t | ts)] \(.text)") | join("\n");
def quote: split("\n") | map(gsub("[\f\\s]+$"; "") | select(test("\\S"))) | map("> " + .) | join("  \n");
($tr[0].events // []) as $ev | ($sl[0] // []) as $s | ($tr[0].lang_line // "") as $lang
| "# \($title)\n\nSource: \($url)" + (if $lang != "" then "  \nTranscript: \($lang)" else "" end) + "\n"
+ if ($s | length) == 0 then
    (if ($ev | length) > 0 then "\n## Transcript\n\n" + ($ev | lines) + "\n" else "" end)
  else
    ([$ev[] | select(.t < $s[0].t)] as $intro
     | if ($intro | length) > 0 then "\n## [00:00] Intro\n\n" + ($intro | lines) + "\n" else "" end)
    + ([range($s | length) as $i | $s[$i] as $x | ($s[$i + 1].t // infinite) as $end
        | [$ev[] | select(.t >= $x.t and .t < $end)] as $said
        | "\n## [\($x.t | ts)] Slide \($i + 1)\n\n![slide \($i + 1)](\($x.img))\n"
          + (($x.text | quote) as $q | if $q != "" then "\n" + $q + "\n" else "" end)
          + (if ($said | length) > 0 then "\n" + ($said | lines) + "\n" else "" end)] | join(""))
  end
JQ

IFS= read -r -d '' AWK_TEXTDEDUP <<'AWK' || true
# tesseract .tsv files (in slide order) -> "base<TAB>start_frame" per kept slide (base = path without .tsv).
# A slide starts at the frame after the previous candidate; a build that replaces it keeps that start.
# Words = confident (>= 60%) tokens of 3+ chars. Footer words on > 35% of pages are ignored when comparing.
# Each page is compared with the previous kept page:
#   same slide                  -> keep the page with more words
#   previous ⊆ current          -> current replaces it (bullet builds, popups, typing animations)
#   current ⊆ previous          -> current dropped (fade-outs, partial frames)
# Containment needs >= 3 distinctive words, so a slide that only repeats the footer is kept.
# A page whose words clearly match an earlier kept page (not just the previous one) is a revisit: dropped.
# Pages with < 3 words are dropped (speaker shots, logos, blank frames).
# Runs with LC_ALL=C: bytes >= 128 (accents) stay inside words; ASCII punctuation and “ ” « » ¿ ¡ split them.
FNR == 1 { f[++N] = FILENAME; cnt[N] = 0; words[N] = "" }
FNR > 1 && $11 + 0 >= 60 {
  s = tolower($12); gsub(/(“|”|«|»|¿|¡)/, " ", s); gsub(/[[:space:][:punct:]]+/, " ", s); k = split(s, a, " ")
  for (i = 1; i <= k; i++)
    if (length(a[i]) >= 3 && !((N, a[i]) in has)) { has[N, a[i]] = 1; cnt[N]++; df[a[i]]++; words[N] = words[N] " " a[i] }
}
# revisit(p, c): both pages have >= 3 distinctive words and share >= 80% of them
function revisit(p, c,   a, k, j, dp, dc, ip) {
  dp = dc = ip = 0
  k = split(words[p], a, " "); for (j = 1; j <= k; j++) if (df[a[j]] <= maxdf) { dp++; if ((c, a[j]) in has) ip++ }
  k = split(words[c], a, " "); for (j = 1; j <= k; j++) if (df[a[j]] <= maxdf) dc++
  return dp >= 3 && dc >= 3 && ip / (dp + dc - ip) >= 0.8
}
function frame(i,   b) { b = f[i]; sub(/.*\//, "", b); sub(/\.tsv$/, "", b); return b + 0 }
function rel(p, c,   a, k, j, dp, dc, ip, ai) {
  dp = dc = ip = ai = 0
  k = split(words[p], a, " ")
  for (j = 1; j <= k; j++) { if ((c, a[j]) in has) ai++; if (df[a[j]] <= maxdf) { dp++; if ((c, a[j]) in has) ip++ } }
  k = split(words[c], a, " ")
  for (j = 1; j <= k; j++) if (df[a[j]] <= maxdf) dc++
  if (dp >= 2 && dc >= 2) {
    if (ip / (dp + dc - ip) >= t) return cnt[c] >= cnt[p] ? "replace" : "drop"   # same slide: keep the fuller
    if (dp >= 3 && ip / dp >= 0.8) return "replace"
    if (dc >= 3 && ip / dc >= 0.8) return "drop"
    return ""
  }
  # few distinctive words: near-identical pages, or a tiny page (<= 4 words) inside its neighbour
  if (ai / (cnt[p] + cnt[c] - ai) >= 0.9) return cnt[c] >= cnt[p] ? "replace" : "drop"
  if (cnt[p] <= 4 && ai / cnt[p] >= 0.8) return "replace"
  return (cnt[c] <= 4 && ai / cnt[c] >= 0.8) ? "drop" : ""
}
END {
  for (i = 1; i <= N; i++) if (cnt[i] >= 3) T++          # footer words: on > 35% of the pages with text
  maxdf = T > 4 ? int(T * 0.35) : T; if (maxdf < 2) maxdf = 2
  for (i = 1; i <= N; i++) {
    if (cnt[i] < 3) continue
    r = kept ? rel(out[kept], i) : ""
    if (r == "") for (j = 1; j < kept; j++) if (revisit(out[j], i)) { r = "drop"; break }
    if (r == "replace") out[kept] = i; else if (r == "") { out[++kept] = i; st[kept] = i > 1 ? frame(i - 1) + 1 : 1 }
  }
  for (i = 1; i <= kept; i++) { p = f[out[i]]; sub(/\.tsv$/, "", p); print p "\t" st[i] }
}
AWK

# install_hint TOOL... — one ready-to-run command for this machine's package manager
install_hint() {
  local pm cmd t p pkgs="" extra=""
  if   command -v brew    >/dev/null; then pm=brew;   cmd="brew install"
  elif command -v apt-get >/dev/null; then pm=apt;    cmd="sudo apt install -y"
  elif command -v dnf     >/dev/null; then pm=dnf;    cmd="sudo dnf install -y"
  elif command -v pacman  >/dev/null; then pm=pacman; cmd="sudo pacman -S --needed"
  else printf 'install these with your package manager: %s\n' "$*"; return; fi
  for t; do
    case $pm:$t in
      brew:pdfunite|pacman:pdfunite) p=poppler ;;
      apt:pdfunite|dnf:pdfunite)     p=poppler-utils ;;
      apt:tesseract)                 p=tesseract-ocr ;;
      brew:whisper-cli)              p=whisper-cpp ;;
      apt:whisper-cli)               p=whisper.cpp ;;
      *:whisper-cli)                 p=""; extra="  whisper-cli: see https://github.com/ggml-org/whisper.cpp" ;;
      *)                             p=$t ;;
    esac
    [[ -n $p ]] && pkgs="$pkgs $p"
  done
  [[ -n $pkgs ]] && printf '%s%s\n' "$cmd" "$pkgs"
  [[ -n $extra ]] && printf '%s\n' "$extra"
  return 0
}

# stt_engine: the on-device speech-to-text tool for local videos (VIDEO2INFO_STT=yap|whisper to force one)
stt_engine() {
  case ${VIDEO2INFO_STT:-} in
    yap)     command -v yap >/dev/null && echo yap ;;
    whisper) command -v whisper-cli >/dev/null && echo whisper-cli ;;
    *) if [[ $(uname -s) == Darwin ]] && command -v yap >/dev/null; then echo yap
       elif command -v whisper-cli >/dev/null; then echo whisper-cli; fi ;;
  esac
  return 0
}
stt_hint() {
  if [[ $(uname -s) == Darwin ]]; then echo "brew install yap  (macOS 26+; or: brew install whisper-cpp)"
  else install_hint whisper-cli | tr -s '\n' ' '; fi
}

# video2info --check: show which tools are installed, and how to install the missing ones
check() {
  local t missing=()
  for t in yt-dlp jq ffmpeg tesseract pdfunite curl; do
    if command -v "$t" >/dev/null; then printf '  \033[32m✓\033[0m %s\n' "$t"
    else printf '  \033[31m✗\033[0m %s\n' "$t"; missing+=("$t"); fi
  done
  if [[ -n $(stt_engine) ]]; then printf '  \033[32m✓\033[0m %s (local video transcripts)\n' "$(stt_engine)"
  else printf '  \033[33m-\033[0m local video transcripts (optional): %s\n' "$(stt_hint)"; fi
  command -v tesseract >/dev/null && printf 'OCR languages: %s installed (more: tesseract --list-langs)\n' \
    "$(tesseract --list-langs 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')"
  ((${#missing[@]} == 0)) && return 0
  printf '\n\033[31mmissing:\033[0m %s\ninstall with:\n  %s\n' "${missing[*]}" "$(install_hint "${missing[@]}")"
  return 1
}

# ---------------------------------------------------------------- arguments
INPUTS=() OUT=Combined FORMATS=md DIR="" CROP="" SUB_LANG="" OCR_LANG=eng SSIM=0.9 TEXT_SIM=0.6
JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)
DO_TRANSCRIPT=1 DO_SLIDES=1 CHECK=0
while (($#)); do
  case $1 in
    -o|--output)       OUT=${2:?}; OUT=${OUT%.*}; shift ;;
    -f|--format)       FORMATS=${2:?}; shift ;;
    -d|--output-dir)   DIR=${2:?}; shift ;;
    --crop)            CROP=${2:?}; shift ;;
    -l|--lang)         SUB_LANG=${2:?}; shift ;;
    --ocr-lang)        OCR_LANG=${2:?}; shift ;;
    -j|--jobs)         JOBS=${2:?}; shift ;;
    --ssim)            SSIM=${2:?}; shift ;;
    --transcript-only) DO_SLIDES=0 ;;
    --no-transcript)   DO_TRANSCRIPT=0 ;;
    -h|--help)         usage; exit 0 ;;
    --check)           CHECK=1 ;;
    -V|--version)      echo "video2info $VERSION"; exit 0 ;;
    -*)                usage >&2; die "unknown option: $1" ;;
    *)                 INPUTS+=("$1") ;;
  esac
  shift
done

# --crop right=25%,bottom=10%  ->  ffmpeg crop filter (percent of width/height)
CROPF=""
if [[ -n $CROP ]]; then
  l=0 r=0 t=0 b=0
  for kv in ${CROP//,/ }; do
    v=${kv#*=}; v=${v%\%}
    [[ $kv == *=* && $v =~ ^[0-9]+$ ]] || die "--crop: expected side=N%, got '$kv'"
    case ${kv%%=*} in left) l=$v ;; right) r=$v ;; top) t=$v ;; bottom) b=$v ;; *) die "--crop: unknown side '${kv%%=*}'" ;; esac
  done
  ((l + r < 90 && t + b < 90)) || die "--crop: that leaves almost nothing"
  CROPF="crop=iw*$((100 - l - r))/100:ih*$((100 - t - b))/100:iw*$l/100:ih*$t/100,"
fi
WANT_MD=0 WANT_PDF=0 WANT_TXT=0
for fmt in ${FORMATS//,/ }; do
  case $fmt in md) WANT_MD=1 ;; pdf) WANT_PDF=1 ;; txt) WANT_TXT=1 ;; *) die "--format: unknown format '$fmt' (md, pdf, txt)" ;; esac
done
((WANT_MD || WANT_PDF)) || DO_SLIDES=0          # txt only: no slides needed
((WANT_MD || WANT_TXT)) || DO_TRANSCRIPT=0      # pdf only: no transcript needed
((DO_SLIDES || DO_TRANSCRIPT)) || die "nothing to do: check --format, --transcript-only and --no-transcript"

if ((CHECK)); then check; exit $?; fi
((${#INPUTS[@]})) || { usage >&2; exit 1; }

# existing files → local mode (any number); otherwise exactly one URL.
# A path with shell escapes inside quotes ("a\ b.mp4") is accepted too.
LOCAL=0
for i in "${!INPUTS[@]}"; do
  f=${INPUTS[i]}; [[ ! -e $f && -f ${f//\\/} ]] && INPUTS[i]=${f//\\/}
done
if [[ -f ${INPUTS[0]} ]]; then
  LOCAL=1
  ((DO_TRANSCRIPT)) && [[ -z $(stt_engine) ]] \
    && die "local video transcripts need yap (macOS) or whisper-cli (whisper.cpp)
install with:  $(stt_hint)
(or add --no-transcript for slides only)"
  for f in "${INPUTS[@]}"; do [[ -f $f ]] || die "no such file: $f"; done
else
  [[ ${INPUTS[0]} == *://* ]] || die "no such file: ${INPUTS[0]} (URLs start with https://)"
  ((${#INPUTS[@]} == 1)) || die "only one URL allowed (local files can be several)"
fi

need=(jq)
if ((LOCAL)); then [[ $(stt_engine) == whisper-cli ]] && ((DO_TRANSCRIPT)) && need+=(ffmpeg curl); else need+=(yt-dlp curl); fi
((DO_SLIDES)) && need+=(ffmpeg tesseract)
((DO_SLIDES && WANT_PDF)) && need+=(pdfunite)
missing=() ; for t in "${need[@]}"; do command -v "$t" >/dev/null || missing+=("$t"); done
((${#missing[@]} == 0)) || die "missing: ${missing[*]}
install with:  $(install_hint "${missing[@]}")
(run 'video2info --check' for the full list)"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/video2info.XXXXXX")
trap '[[ -n ${VIDEO2INFO_KEEP:-} ]] && echo "kept temp: $tmp" >&2 || rm -rf "$tmp"' EXIT
DIR=${DIR:-outputs/$(date +%Y-%m-%d_%H-%M-%S)}
mkdir -p "$DIR"

# ---------------------------------------------------------------- steps
# transcript INFO_JSON OUT_JSON — YouTube captions → tr.json
transcript() {
  local info=$1 out=$2 sel key src url sub=${1%/*}/sub.json3
  sel=$(jq -r --arg lang "$SUB_LANG" "$JQ_CAPTIONS" "$info" 2>&1) \
    || { warn "transcript: ${sel#jq: error*: }"; return 1; }
  IFS=$'\t' read -r key src url <<<"$sel"
  if ! { [[ -n $url ]] && curl -fsSL -A 'Mozilla/5.0' -o "$sub" "$url"; }; then
    yt-dlp -q --no-warnings --load-info-json "$info" --skip-download --write-subs --write-auto-subs \
      --sub-langs "$key" --sub-format json3 -o "${sub%.json3}" || return 1
    mv "${sub%.json3}".*json3 "$sub" 2>/dev/null || { warn "transcript: download failed ($key)"; return 1; }
  fi
  jq --arg lang_line "$key (source: $src, video default: $(jq -r '.language // "unknown"' "$info"))" \
    "$JQ_EVENTS" "$sub" >"$out"
  log "transcript: $(jq '.events | length' "$out") lines ($key, $src)"
}

# whisper_model LANG — path of the whisper.cpp model (English-only model for en, else multilingual)
whisper_model() {
  [[ -n ${VIDEO2INFO_WHISPER_MODEL:-} ]] && { echo "$VIDEO2INFO_WHISPER_MODEL"; return; }
  local name=ggml-base.bin dir=${XDG_CACHE_HOME:-$HOME/.cache}/video2info
  [[ $1 == en ]] && name=ggml-base.en.bin
  if [[ ! -s $dir/$name ]]; then
    log "downloading whisper model $name (once, ~150 MB) → $dir"
    mkdir -p "$dir"
    local bar=-sS; [[ -t 2 ]] && bar=--progress-bar
    curl -fL "$bar" -o "$dir/$name.part" \
      "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$name" && mv "$dir/$name.part" "$dir/$name" \
      || { rm -f "$dir/$name.part"; return 1; }
  fi
  echo "$dir/$name"
}

# local_transcript VIDEO_FILE WORK_DIR OUT_JSON — on-device speech recognition → tr.json (same shape as YouTube)
local_transcript() {
  local file=$1 work=$2 out=$3 loc=${SUB_LANG:-en-US} engine events lang_line
  [[ $loc == default || $loc == auto ]] && loc=en-US
  engine=$(stt_engine)
  log "transcribing on-device with $engine ($loc)…"
  if [[ $engine == yap ]]; then
    yap transcribe "$file" --json -l "$loc" -m 120 -o "$work/yap.json" >/dev/null 2>"$work/stt.err" \
      || { warn "transcript: yap failed: $(tail -1 "$work/stt.err")"; return 1; }
    events=$(jq '{events: [.segments[]? | {tStartMs: (.start * 1000 | floor), segs: [{utf8: .text}]}]}' "$work/yap.json")
    lang_line="$(jq -r --arg l "$loc" '.metadata.locale // .locale // $l' "$work/yap.json") (source: on-device speech recognition, yap)"
  else
    local lang=${loc%%[-_]*} model
    model=$(whisper_model "$lang") || { warn "transcript: whisper model download failed"; return 1; }
    ffmpeg -nostdin -loglevel error -i "$file" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$work/audio.wav" \
      && whisper-cli -np -m "$model" -l "$lang" -t "$JOBS" -oj -of "$work/whisper" -f "$work/audio.wav" \
           >/dev/null 2>"$work/stt.err" \
      || { warn "transcript: whisper-cli failed: $(tail -1 "$work/stt.err")"; return 1; }
    events=$(jq '{events: [.transcription[]? | {tStartMs: .offsets.from, segs: [{utf8: .text}]}]}' "$work/whisper.json")
    lang_line="$lang (source: on-device speech recognition, whisper.cpp ${model##*/})"
  fi
  jq --arg lang_line "$lang_line" "$JQ_EVENTS" <<<"$events" >"$out"
  log "transcript: $(jq '.events | length' "$out") lines"
}

# slides WORK_DIR [VIDEO_FILE] — writes WORK_DIR/slides.tsv ("base<TAB>start_ms" per slide; base.jpg/.txt/.pdf).
# Without VIDEO_FILE the video is streamed with yt-dlp from WORK_DIR/info.json.
slides() {
  local work=$1 file=${2:-} frames=$1/frames keep=$1/keep
  local vf="fps=0.5,${CROPF}scale='min(1280,iw)':-2"
  mkdir -p "$frames" "$keep"

  # 1. frames: 1 every 2 s, max 1280 px wide. URLs stream ≤720p straight into ffmpeg (never saved).
  if [[ -n $file ]]; then
    ffmpeg -nostdin -loglevel error -i "$file" -vf "$vf" -q:v 2 "$frames/%05d.jpg"
  else
    yt-dlp -q --no-warnings --load-info-json "$work/info.json" -o - \
        -f 'bv[height<=720][vcodec^=avc1]/bv[height<=720]/b[height<=720]/b' \
      | ffmpeg -nostdin -loglevel error -i pipe:0 -vf "$vf" -q:v 2 "$frames/%05d.jpg"
  fi || { warn "frame extraction failed"; return 1; }
  local n; n=$(find "$frames" -name '*.jpg' | wc -l | tr -d ' ')
  ((n > 0)) || { warn "no frames extracted"; return 1; }

  # 2. slide changes: SSIM of each frame vs the next (bottom 12% ignored: progress bars, captions).
  #    Keep the LAST frame of every stable run: complete bullet builds, no mid-transition frames.
  ffmpeg -nostdin -loglevel error -i "$frames/%05d.jpg" -start_number 2 -i "$frames/%05d.jpg" -lavfi \
      "[0]crop=iw:ih*0.88:0:0,scale=480:-2,format=gray[a];[1]crop=iw:ih*0.88:0:0,scale=480:-2,format=gray[b];[a][b]ssim=stats_file=$work/ssim.log" \
      -f null - || true
  { LC_ALL=C awk -v t="$SSIM" '{sub("n:", "", $1); sub("Y:", "", $2)} $2 < t {print $1}' "$work/ssim.log" 2>/dev/null; echo "$n"; } \
    | while read -r i; do f=$(printf %05d.jpg "$i"); ln "$frames/$f" "$keep/$f"; done
  log "$n frames → $(find "$keep" -name '*.jpg' | wc -l | tr -d ' ') slide candidates"

  # 3. OCR in parallel: one tesseract run per slide → text + word confidences (+ searchable PDF page)
  local configs="txt tsv"; ((WANT_PDF)) && configs="pdf txt tsv"
  find "$keep" -name '*.jpg' -print0 \
    | OMP_THREAD_LIMIT=1 xargs -0 -P "$JOBS" -I{} sh -c \
        'tesseract "$1" "${1%.jpg}" -l "$2" --psm 3 $3 >/dev/null 2>&1' _ {} "$OCR_LANG" "$configs"

  # 4. drop text-less frames, merge neighbours with the same words (keep the fuller one), drop revisits
  LC_ALL=C awk -F'\t' -v t="$TEXT_SIM" "$AWK_TEXTDEDUP" "$keep"/*.tsv \
    | LC_ALL=C awk -F'\t' '{print $1 "\t" ($2 - 1) * 2000}' >"$work/slides.tsv"
  [[ -s $work/slides.tsv ]] || { warn "no slides with text found"; return 1; }
  log "slides: $(wc -l <"$work/slides.tsv" | tr -d ' ')"
}

# write_pdf WORK_DIR OUT_PDF — join the searchable pages of the kept slides
write_pdf() {
  local pages=() b t
  while IFS=$'\t' read -r b t; do pages+=("$b.pdf"); done <"$1/slides.tsv"
  if ((${#pages[@]} == 1)); then cp "${pages[0]}" "$2"; else pdfunite "${pages[@]}" "$2"; fi && log "pdf: ${#pages[@]} pages → $2"
}

# write_md WORK_DIR NAME — NAME.md with NAME_assets/slide-NN.jpg (slides optional, transcript optional)
write_md() {
  local work=$1 name=$2 b t i=0 img
  : >"$work/slides.jsonl"
  if [[ -s $work/slides.tsv ]]; then
    mkdir -p "$DIR/${name}_assets"
    while IFS=$'\t' read -r b t; do
      i=$((i + 1)); img=$(printf '%s_assets/slide-%02d.jpg' "$name" "$i")
      cp "$b.jpg" "$DIR/$img"
      jq -n --argjson t "$t" --arg img "$img" --rawfile text "$b.txt" '{t: $t, img: $img, text: $text}' >>"$work/slides.jsonl"
    done <"$work/slides.tsv"
  fi
  jq -s . "$work/slides.jsonl" >"$work/slides.json"
  jq -nr --arg title "$(jq -r .title "$work/meta.json")" --arg url "$(jq -r .url "$work/meta.json")" \
    --slurpfile tr "$work/tr.json" --slurpfile sl "$work/slides.json" "$JQ_TS $JQ_MD" >"$DIR/$name.md"
  log "md: $i slides → $DIR/$name.md"
}

# ---------------------------------------------------------------- main
if ((LOCAL)); then
  printf '%s\n' "${INPUTS[@]}" | jq -Rrs "$JQ_FILES" >"$tmp/entries.tsv"
else
  log "probing ${INPUTS[0]}"
  yt-dlp -q --no-warnings --flat-playlist -J "${INPUTS[0]}" >"$tmp/probe.json"
  single=$(jq 'has("entries") | not' "$tmp/probe.json")
  jq -r "$JQ_ENTRIES" "$tmp/probe.json" >"$tmp/entries.tsv"
fi

mds=() pdfs=() txts=()
while IFS=$'\t' read -r -u 3 order src title; do
  name=$(printf '%02d_%s' "$order" "$title")
  vt=$tmp/$order && mkdir -p "$vt"
  log "[$order] $title"
  file=""
  if ((LOCAL)); then
    file=$src
    base=${file##*/}
    jq -n --arg title "${base%.*}" --arg txt_title "$base" --arg url "$file" '{$title, $txt_title, $url}' >"$vt/meta.json"
  else
    if [[ $single == true ]]; then cp "$tmp/probe.json" "$vt/info.json"
    else yt-dlp -q --no-warnings -J --skip-download "$src" >"$vt/info.json" || { warn "metadata failed: $src"; continue; }
    fi
    jq '{title: (.title // ""), url: (.webpage_url // "")}' "$vt/info.json" >"$vt/meta.json"
  fi
  echo '{"lang_line": "", "events": []}' >"$vt/tr.json"
  have_tr=0
  if ((DO_TRANSCRIPT)); then
    if [[ -n $file ]]; then local_transcript "$file" "$vt" "$vt/tr.json"
    else transcript "$vt/info.json" "$vt/tr.json"; fi && have_tr=1
  fi
  have_slides=0
  ((DO_SLIDES)) && slides "$vt" "$file" && have_slides=1

  if ((WANT_TXT && have_tr)); then
    jq -r --arg title "$(jq -r '.txt_title // .title' "$vt/meta.json")" --arg url "$(jq -r .url "$vt/meta.json")" \
      "$JQ_TS $JQ_TXT" "$vt/tr.json" >"$DIR/$name.txt" && txts+=("$DIR/$name.txt") && log "txt: → $DIR/$name.txt"
  fi
  if ((WANT_PDF && have_slides)) && write_pdf "$vt" "$DIR/$name.pdf"; then pdfs+=("$DIR/$name.pdf"); fi
  if ((WANT_MD && (have_slides || have_tr))) && write_md "$vt" "$name"; then mds+=("$DIR/$name.md"); fi
  [[ -n ${VIDEO2INFO_KEEP:-} ]] || rm -rf "$vt"
done 3<"$tmp/entries.tsv"

# several videos → one combined file per format
if ((${#mds[@]} > 1)); then
  for f in "${mds[@]}"; do cat "$f"; printf '\n---\n\n'; done >"$DIR/$OUT.md" && log "combined: $DIR/$OUT.md"
fi
if ((${#pdfs[@]} > 1)); then pdfunite "${pdfs[@]}" "$DIR/$OUT.pdf" && log "combined: $DIR/$OUT.pdf"; fi
if ((${#txts[@]} > 1)); then
  for f in "${txts[@]}"; do cat "$f"; printf '\n\n%s\n\n' "$(printf '#%.0s' {1..80})"; done >"$DIR/$OUT.txt"
  log "combined: $DIR/$OUT.txt"
fi
log "done → $DIR/"
